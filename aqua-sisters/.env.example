# ─── Aqua Sisters – omgevingsvariabelen ───
# Kopieer naar .env.local (lokaal) of zet ze in Vercel → Project → Settings → Environment Variables.
# Zet NOOIT echte sleutels in Git.

# Database (Supabase → Project Settings → Database → Connection string → "Transaction pooler", poort 6543)
DATABASE_URL=postgres://postgres.xxxxxxxx:WACHTWOORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optioneel: max. verbindingen per serverinstantie (standaard 5)
# DATABASE_POOL_MAX=5

# Publieke URL van de site, zonder slash aan het eind (nodig voor betaal-redirects, webhooks en e-maillinks)
APP_URL=https://www.aquasisters.nl

# Betalingen – Mollie (Dashboard → Developers → API keys). test_… voor testen, live_… voor echte betalingen.
PAYMENT_PROVIDER=mollie
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail – Resend (resend.com → API Keys). Afzender moet op een geverifieerd domein staan.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Aqua Sisters <tickets@aquasisters.nl>
EMAIL_REPLY_TO=info@aquasisters.nl

# Sleutel om 2FA-geheimen versleuteld op te slaan. Genereer met: openssl rand -base64 32
ENCRYPTION_KEY=

# Geheim voor de geplande taken (/api/cron). Genereer met: openssl rand -hex 32
CRON_SECRET=

# ─── Alleen voor lokaal testen ───
# PAYMENT_PROVIDER=mock
# ALLOW_MOCK_PAYMENTS=true      # testbetalingen; wordt geweigerd op Vercel-productie
# ADMIN_2FA_OPTIONAL=true       # 2FA niet afdwingen (nooit in productie gebruiken)
