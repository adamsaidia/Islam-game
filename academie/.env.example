# --- AI (optioneel, betaald per gebruik) ---
# Zonder deze sleutel werkt de app volledig, behalve AI-gesprekken, AI-correctie en de AI-docent.
ANTHROPIC_API_KEY=
# Standaardmodel. Goedkoper alternatief: claude-haiku-5-5 (ca. 40x goedkoper, iets minder nauwkeurig).
AI_MODEL=claude-opus-5-5
# Beschermt je AI-routes als de app publiek online staat. Vul dezelfde code in bij Instellingen.
APP_ACCESS_CODE=

# --- Supabase (optioneel, gratis tier) ---
# Zonder Supabase wordt je voortgang lokaal in je browser bewaard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
